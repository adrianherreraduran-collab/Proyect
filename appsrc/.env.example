# FVMarket - variables privadas para producción
PUBLIC_URL=https://tu-dominio-publico.example
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=FVMarket <pedidos@tu-dominio.example>

# Stripe Online Payments (usa sk_test_... y whsec_... durante las pruebas)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Aplicación
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PIN=

# OCR local de capturas (por defecto activo y sin coste por API)
TESSERACT_CACHE_PATH=/tmp/fvmarket-tesseract
# Opcional: solo si se quiere usar OpenAI cuando el OCR local no encuentre texto
FVM_OPENAI_CAPTURE_FALLBACK=false
